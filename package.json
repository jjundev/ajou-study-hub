{
  "name": "ajou-study-hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "ci:sources": "tsx tools/ci/sources-cli.ts",
    "ci:notify": "tsx tools/ci/notify.ts",
    "ci:notifiers": "tsx tools/ci/notifier-templates.ts",
    "test": "vitest run",
    "fixtures:create": "tsx tools/create-fixture.ts",
    "content:build": "tsx tools/cli.ts content:build",
    "build": "tsx tools/cli.ts build",
    "dev": "tsx tools/cli.ts dev",
    "test:e2e": "playwright test",
    "verify:content": "tsx tools/verify-content.ts",
    "hosting:dev": "wrangler dev --local --ip 127.0.0.1",
    "bootstrap:build": "tsx tools/deploy/bootstrap.ts build",
    "deploy:bootstrap": "tsx tools/deploy/bootstrap.ts upload",
    "access:verify": "tsx tools/deploy/access.ts",
    "access:verify-production": "tsx tools/deploy/human-approval.ts",
    "access:approve-automation": "tsx tools/deploy/access-baseline.ts",
    "deploy:private": "tsx tools/cli.ts deploy:private"
  },
  "dependencies": {
    "parse5": "8.0.1",
    "postcss": "8.5.31",
    "postcss-value-parser": "4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "wrangler": "4.152.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
